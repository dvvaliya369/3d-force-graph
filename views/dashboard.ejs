<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="nav-title">Google OAuth App</h1>
            <div class="nav-links">
                <a href="/dashboard">Dashboard</a>
                <a href="/profile">Profile</a>
                <a href="/auth/logout">Logout</a>
            </div>
        </div>
    </nav>
    
    <main class="container">
        <div class="dashboard-card">
            <div class="user-welcome">
                <img src="<%= user.photo %>" alt="Profile Photo" class="profile-photo">
                <div class="user-info">
                    <h1>Welcome back, <%= user.name %>!</h1>
                    <p class="user-email"><%= user.email %></p>
                </div>
            </div>
            
            <div class="dashboard-content">
                <h2>Dashboard</h2>
                <p>You are successfully authenticated with Google OAuth!</p>
                
                <div class="feature-cards">
                    <div class="feature-card">
                        <h3>Profile Information</h3>
                        <p>View and manage your profile details</p>
                        <a href="/profile" class="btn btn-primary">View Profile</a>
                    </div>
                    
                    <div class="feature-card">
                        <h3>API Access</h3>
                        <p>Access your user data via API</p>
                        <button onclick="fetchUserData()" class="btn btn-secondary">Test API</button>
                    </div>
                </div>
                
                <div id="api-result" class="api-result" style="display: none;">
                    <h4>API Response:</h4>
                    <pre id="api-data"></pre>
                </div>
            </div>
        </div>
    </main>
    
    <script>
        async function fetchUserData() {
            try {
                const response = await fetch('/api/user');
                const data = await response.json();
                
                document.getElementById('api-data').textContent = JSON.stringify(data, null, 2);
                document.getElementById('api-result').style.display = 'block';
            } catch (error) {
                console.error('Error fetching user data:', error);
                alert('Error fetching user data');
            }
        }
    </script>
</body>
</html>
